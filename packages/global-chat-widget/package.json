{
  "name": "@rotary/global-chat-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Shared SSO message hub chat widget. Used by rotarycredit / wahoot / account-rotary (R4 鐵則 — single source of truth for chat UI).",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/internal/messageClient.ts",
      "import": "./src/internal/messageClient.ts",
      "default": "./src/internal/messageClient.ts"
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "next": ">=14",
    "date-fns": ">=3"
  },
  "dependencies": {
    "lucide-react": "^0.575.0"
  }
}
